<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="ae5d5b72-f196-4d58-944a-6011d6e3ced0"
        type="watchface"
        name="@Strings.AppName"
        entry="ContextAheadApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="4.2.0">
        <iq:products>
            <!-- Garmin uses this one target for both the 45 mm and the 50 mm Instinct 3 Solar -->
            <iq:product id="instinct3solar45mm" />
        </iq:products>
        <iq:permissions>
            <!-- pressure and elevation history: the barometer trend, and whether the watch was climbing -->
            <iq:uses-permission id="SensorHistory" />
            <!-- the last GPS fix: sun times and the forecast location -->
            <iq:uses-permission id="Positioning" />
            <!-- Open-Meteo weather: a background fetch through the phone -->
            <iq:uses-permission id="Background" />
            <iq:uses-permission id="Communications" />
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels />
    </iq:application>
</iq:manifest>
