// Generated by tools/make_project.py: the on-watch settings menu, in the same order as the phone
// settings. Stored values are the option positions. Each setting's texts are one string resource
// ("Title|Option|..."), loaded only while the menu shows it, so they cost no memory while the face runs.
import Toybox.Lang;
import Toybox.WatchUi;

module SetText {
    const DEFAULTS = [0, 0, 0, 4, 0, 0, 0]b;
    const COUNTS = [16, 10, 3, 9, 2, 2, 3]b;
    const MENUS = [Rez.Strings.menu0, Rez.Strings.menu1, Rez.Strings.menu2, Rez.Strings.menu3, Rez.Strings.menu4, Rez.Strings.menu5, Rez.Strings.menu6];

    // field j of setting i's menu string (0 the title, 1.. the options)
    function text(i, j) {
        var s = WatchUi.loadResource(MENUS[i]) as Lang.String;
        for (var k = 0; k < j; k += 1) {
            s = s.substring((s.find("|") as Lang.Number) + 1, s.length()) as Lang.String;
        }
        var e = s.find("|");
        return (e == null) ? s : s.substring(0, e);
    }
}
